{
  "specVersion": 1,
  "meta": {
    "id": "example-com",
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "qualityTier": "high"
  },
  "style": {
    "tokens": {
      "palette": [
        "#334488",
        "#22D3EE",
        "#F8FAFC"
      ],
      "fontDisplay": "Space Grotesk",
      "fontBody": "Inter",
      "stageBg": "#334488"
    }
  },
  "scenes": [
    {
      "type": "typography",
      "id": "title",
      "startMs": 0,
      "durationMs": 2800,
      "transitionIn": {
        "type": "cut",
        "ms": 0
      },
      "transitionOut": {
        "type": "dissolve",
        "ms": 400
      },
      "params": {
        "lines": [
          {
            "text": "Example Domain",
            "size": 118,
            "weight": 700,
            "font": "display",
            "color": "fg",
            "tracking": 0
          },
          {
            "text": "This domain is for use in documentation examples without needing permi",
