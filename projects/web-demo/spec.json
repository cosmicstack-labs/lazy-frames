      "id": "parallax",
      "startMs": 5600,
      "durationMs": 3400,
      "transitionIn": {
        "type": "fade",
        "ms": 400
      },
      "transitionOut": {
        "type": "dissolve",
        "ms": 400
      },
      "params": {
        "src": "assets/sites/example.com/full.png",
        "move": "dolly-in",
        "grade": "none",
        "overlay": "vignette",
        "bg": {
          "type": "solid",
          "color": "#334488"
        }
      }
    },
    {
      "type": "ui-callout",
      "id": "callout",
      "startMs": 8600,
      "durationMs": 3200,
      "transitionIn": {
        "type": "fade",
        "ms": 400
      },
      "transitionOut": {
        "type": "dissolve",
        "ms": 400
      },
      "params": {
        "src": "assets/sites/example.com/hero.png",
