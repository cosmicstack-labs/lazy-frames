    },
    {
      "type": "browser-frame",
      "id": "browser",
      "startMs": 2400,
      "durationMs": 3600,
      "transitionIn": {
        "type": "fade",
        "ms": 400
      },
      "transitionOut": {
        "type": "dissolve",
        "ms": 400
      },
      "params": {
        "src": "assets/sites/example.com/hero.png",
        "url": "example.com",
        "zoom": "slow-in",
        "cursor": {
          "moves": [
            {
              "xPct": 34,
              "yPct": 40,
              "atMs": 900
            },
            {
              "xPct": 62,
              "yPct": 58,
              "atMs": 2100
            }
          ],
          "clickAtMs": 2800
        },
        "bg": {
          "type": "solid",
          "color": "#334488"
        }
      }
    },
    {
