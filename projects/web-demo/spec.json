        "zoomStrength": 8,
        "bg": {
          "type": "solid",
          "color": "#334488"
        }
      }
    },
    {
      "type": "typography",
      "id": "lockup",
      "startMs": 11400,
      "durationMs": 2600,
      "transitionIn": {
        "type": "fade",
        "ms": 400
      },
      "transitionOut": {
        "type": "cut",
        "ms": 0
