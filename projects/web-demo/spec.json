            "weight": 400,
            "font": "body",
            "color": "accent",
            "tracking": 0,
            "delayMs": 700
          }
        ],
        "align": "center",
        "reveal": "letter-stagger",
        "staggerMs": 200,
        "revealMs": 600,
        "charStaggerMs": 26
