  "audio": {
    "narration": [
      { "text": "Every frame of this film was computed on one small machine. No cloud, no keys.", "startMs": 3600, "voice": "Samantha", "rate": 160, "gainDb": 0 },
      { "text": "Lazy Frames. Video generation that lives where you live.", "startMs": 22600, "voice": "Samantha", "rate": 160, "gainDb": 0 }
    ],
    "music": { "mood": "calm", "bpm": 90, "bars": 12, "seed": 21, "gainDb": -16 }
