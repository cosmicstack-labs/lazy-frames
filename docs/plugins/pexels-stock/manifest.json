{
  "apiVersion": "lazy-frames.cosmicstack.ai/plugin/v1",
  "id": "pexels-stock",
  "name": "Pexels Stock Media",
  "version": "0.1.0",
  "description": "A stock-media scaffold for searching and freezing licensed Pexels images and footage into a project.",
  "publisher": {
    "name": "Cosmic Stack",
    "url": "https://cosmicstack.ai",
    "verified": true
  },
  "provider": {
    "name": "Pexels",
    "url": "https://pexels.com"
  },
  "category": "visuals",
  "tags": [
    "stock-media",
    "image",
    "footage",
    "search"
  ],
  "capabilities": [
    "stock-media",
    "image"
  ],
  "runtime": {
    "type": "scaffold",
    "adapter": "pexels-stock"
  },
  "permissions": {
    "networkHosts": [
      "api.pexels.com"
    ],
    "environment": [
      "PEXELS_API_KEY"
    ],
    "filesystem": [
      "project-assets-write"
    ]
  },
  "homepage": "https://lazy-frames.cosmicstack.ai/plugins/pexels-stock/",
  "featured": true,
  "default": false,
  "installable": true,
  "status": "scaffold"
}
