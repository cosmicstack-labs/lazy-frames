{
  "apiVersion": "lazy-frames.cosmicstack.ai/plugin/v1",
  "id": "elevenlabs",
  "name": "ElevenLabs TTS",
  "version": "1.1.0",
  "description": "Generate scene-linked narration with ElevenLabs voices and normalize it for deterministic Lazy Frames renders.",
  "publisher": {
    "name": "Cosmic Stack",
    "url": "https://cosmicstack.ai",
    "verified": true
  },
  "provider": {
    "name": "ElevenLabs",
    "url": "https://elevenlabs.io"
  },
  "category": "voice",
  "tags": [
    "voice",
    "tts",
    "narration",
    "multilingual"
  ],
  "capabilities": [
    "tts"
  ],
  "runtime": {
    "type": "builtin",
    "adapter": "elevenlabs"
  },
  "permissions": {
    "networkHosts": [
      "api.elevenlabs.io"
    ],
    "environment": [
      "ELEVENLABS_API_KEY"
    ],
    "filesystem": [
      "project-cache-write",
      "project-assets-write"
    ]
  },
  "homepage": "https://lazy-frames.cosmicstack.ai/plugins/elevenlabs/",
  "featured": true,
  "default": true,
  "installable": true,
  "status": "available"
}
