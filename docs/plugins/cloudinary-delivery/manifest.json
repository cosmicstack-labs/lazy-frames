{
  "apiVersion": "lazy-frames.cosmicstack.ai/plugin/v1",
  "id": "cloudinary-delivery",
  "name": "Cloudinary Delivery",
  "version": "0.1.0",
  "description": "A delivery scaffold for uploading approved renders and returning durable asset URLs and metadata.",
  "publisher": {
    "name": "Cosmic Stack",
    "url": "https://cosmicstack.ai",
    "verified": true
  },
  "provider": {
    "name": "Cloudinary",
    "url": "https://cloudinary.com"
  },
  "category": "workflow",
  "tags": [
    "export",
    "delivery",
    "cdn",
    "workflow"
  ],
  "capabilities": [
    "export"
  ],
  "runtime": {
    "type": "scaffold",
    "adapter": "cloudinary-delivery"
  },
  "permissions": {
    "networkHosts": [
      "api.cloudinary.com"
    ],
    "environment": [
      "CLOUDINARY_URL"
    ],
    "filesystem": [
      "project-read"
    ]
  },
  "homepage": "https://lazy-frames.cosmicstack.ai/plugins/cloudinary-delivery/",
  "featured": false,
  "default": false,
  "installable": true,
  "status": "scaffold"
}
