  "id": "cartesia-voice",
  "name": "Cartesia Voice",
  "version": "0.1.0",
  "description": "A low-latency voice provider scaffold for expressive narration and rapid previews.",
  "publisher": {
    "name": "Cosmic Stack",
    "url": "https://cosmicstack.ai",
    "verified": true
  },
  "provider": {
    "name": "Cartesia",
