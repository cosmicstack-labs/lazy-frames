{
  "apiVersion": "lazy-frames.cosmicstack.ai/plugin/v1",
  "id": "deepgram-aura",
  "name": "Deepgram Aura",
  "version": "0.1.0",
  "description": "A Deepgram Aura scaffold for conversational narration generated against scene timing.",
  "publisher": {
    "name": "Cosmic Stack",
    "url": "https://cosmicstack.ai",
    "verified": true
  },
  "provider": {
    "name": "Deepgram",
    "url": "https://deepgram.com"
  },
  "category": "voice",
  "tags": [
    "voice",
    "tts",
    "conversational"
  ],
  "capabilities": [
    "tts"
  ],
  "runtime": {
    "type": "scaffold",
    "adapter": "deepgram-aura"
  },
  "permissions": {
    "networkHosts": [
      "api.deepgram.com"
    ],
    "environment": [
      "DEEPGRAM_API_KEY"
    ],
    "filesystem": [
      "project-cache-write",
      "project-assets-write"
    ]
  },
  "homepage": "https://lazy-frames.cosmicstack.ai/plugins/deepgram-aura/",
  "featured": false,
  "default": false,
  "installable": true,
  "status": "scaffold"
}
